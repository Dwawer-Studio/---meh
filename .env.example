NODE_ENV=development
HOST=127.0.0.1
PORT=8787
MEH_APP_SECRET=replace-with-at-least-32-random-characters
# سر مستقل لمسارات التشغيل الداخلية؛ إلزامي في الإنتاج
MEH_INTERNAL_ADMIN_TOKEN=replace-with-a-different-32-character-token
MEH_ALLOWED_ORIGINS=http://127.0.0.1:4173
# فعّله فقط عندما تكون الخدمة خلف proxy موثوق وفي شبكة داخلية
MEH_TRUST_PROXY=false
# DATABASE_URL=postgresql://meh:password@127.0.0.1:5432/meh
# PG_SSL=disable
# PG_POOL_MAX=10

# P4 — جميعها مغلقة في الإنتاج افتراضيًا. لا تستخدم مفتاح الكتالوج الخاص هنا.
MEH_CARD_CATALOG=false
MEH_TAMASHI_WALLET=false
MEH_FRIENDLY_RECIPES=false
MEH_CATALOG_EXPANSION=false
# MEH_CATALOG_ENVELOPE_PATH=/run/secrets/meh/catalog-envelope.json
# MEH_CATALOG_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
# MEH_CARD_CONTENT_FLAGS=card_example
# MEH_FREE_ROTATION_IDS=example-card
