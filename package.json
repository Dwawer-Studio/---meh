{
  "name": "meh-card-game",
  "version": "0.1.0",
  "private": true,
  "description": "لعبة مِهْ مع أدوات فحص واختبارات خط الأساس",
  "scripts": {
    "check": "node tools/check-all.js",
    "check:clean": "node tools/check-clean.js",
    "serve": "node tools/serve.js",
    "serve:service": "node tools/serve-service.js",
    "check:syntax": "node tools/check-syntax.js",
    "validate": "npm run validate:html && npm run validate:css",
    "validate:html": "html-validate index.html tests/fixtures/responsive-harness.html prototypes/uiux-u0/index.html ui/fixture/index.html",
    "validate:css": "stylelint style.css prototypes/uiux-u0/prototype.css ui/*.css ui/screens/*.css ui/fixture/*.css",
    "check:assets": "node --test tests/assets.test.js",
    "report:telemetry": "node tools/telemetry-report.js",
    "test": "node --test",
    "test:security": "node --test tests/security-network.test.js",
    "test:reliability": "node --test tests/storage.test.js tests/reliability.test.js",
    "test:rules": "node --test tests/game-rules.test.js tests/security-network.test.js",
    "test:quality": "node --test tests/quality.test.js",
    "test:responsive": "node --test tests/responsive.test.js",
    "test:architecture": "node --test tests/architecture.test.js",
    "test:workflows": "node --test tests/workflows.test.js",
    "test:final": "node --test tests/final-audit.test.js",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:smoke": "node --test tests/smoke.test.js tests/storage.test.js tests/game-flow.test.js",
    "test:p2": "node --test tests/match-reducer.test.js tests/p2-postgres-integration.test.js tests/p2-protocol.test.js tests/p2-realtime.test.js tests/p2-service.test.js",
    "test:p2:replay": "node tools/p2-replay-gate.js",
    "test:p2:load": "node tools/p2-load-gate.js",
    "test:p2:network-load": "node tools/p2-realtime-load-gate.js",
    "test:p2:recovery": "node tools/p2-recovery-gate.js",
    "test:p3": "node --test tests/p3-feature-flags.test.js tests/p3-postgres-integration.test.js tests/p3-realtime.test.js tests/p3-returning-majlis.test.js",
    "test:p3:load": "node tools/p3-social-load-gate.js",
    "test:p4": "node --test tests/p4-catalog.test.js tests/p4-feature-flags.test.js tests/p4-postgres-integration.test.js tests/p4-realtime.test.js tests/p4-recipes.test.js tests/p4-runtime.test.js tests/p4-tamashi.test.js",
    "test:p4:simulation": "node tools/p4-simulation-gate.js",
    "test:p4:economy": "node tools/p4-economy-gate.js",
    "uiux:u0:manifests": "node tools/uiux-u0-manifests.js --write",
    "test:uiux-u0": "node --test tests/uiux-u0-contract.test.js",
    "test:uiux-u1": "node --test tests/uiux-u1-design-system.test.js",
    "test:uiux-u2": "node --test tests/uiux-u2-app-shell.test.js && playwright test tests/e2e/uiux-u2.spec.js"
  },
  "engines": {
    "node": "^22.22.0 || >=24.8.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.7",
    "@playwright/test": "1.62.1",
    "html-validate": "^11.10.0",
    "peer": "1.0.2",
    "peerjs": "1.5.4",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended": "^18.0.0",
    "yaml": "2.9.0"
  },
  "dependencies": {
    "pg": "8.23.0",
    "qrcode-generator": "1.4.4",
    "ws": "8.21.3"
  }
}
